# 対象サイトのURL
TARGET_URL=https://example.com/login

# 機密情報（.env にコピーして実際の値を入れる。.env はコミットしないこと）
LOGIN_ID=
LOGIN_PASSWORD=

# セッション情報を保持するディレクトリ
USER_DATA_DIR=./user_data

# ---- SNS管理AI社員 (npm run sns) ----
# Claude API キー (https://console.anthropic.com で発行)
ANTHROPIC_API_KEY=

# X (developer.x.com で発行。アプリ権限は Read and Write)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Threads (Meta for Developers の Threads API)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Instagram (ビジネス/クリエイターアカウント + Instagram Graph API)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Instagramログイン方式のトークンを使う場合は https://graph.instagram.com/v21.0 に変更
INSTAGRAM_GRAPH_BASE=https://graph.facebook.com/v21.0
