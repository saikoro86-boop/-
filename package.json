{
  "name": "tennis-court-finder",
  "version": "1.0.0",
  "description": "奈良県・木津川市のテニスコート空き状況をまとめて見る(ほかに、フォーム自動化・SNS 下書き管理のひな形を含む)",
  "main": "dist/index.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "sns": "ts-node src/sns/cli.ts",
    "test": "node --require ts-node/register --test tests/*.test.ts",
    "courts": "ts-node src/courts/cli.ts",
    "courts:build": "ts-node src/courts/build.ts",
    "bookmarklet": "ts-node src/bookmarklet/build.ts",
    "worker:build": "ts-node worker/build.ts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "dotenv": "^16.4.5",
    "puppeteer": "^25.15.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "twitter-api-v2": "^1.29.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
